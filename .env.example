# Export these variables in your shell; .env files are not automatically loaded.
ACTIONPILOT_DB_PATH=data/actionpilot.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Alternatively set OPENAI_API_KEY in .streamlit/secrets.toml (gitignored).

# Development only: durable local account storage. Do not use on Streamlit Cloud.
AUTH_SQLITE_PATH=data/accounts.db
# Cloud: set AUTH_DATABASE_URL in Streamlit secrets to your hosted PostgreSQL URL.
